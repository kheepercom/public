FROM us.kheeper.com/public/metrics-base:v0.2.1

ARG KERNEL_VERSION=7.0.10-201.fc44.x86_64
# Open kmod source in RPM Fusion lags the proprietary driver. Pin userspace
# to the version that has a matching kmod-nvidia-open build, otherwise nvml
# fails with "Driver/library version mismatch" at runtime.
# Version only; dnf will resolve to whatever -release the repo has for each
# package (akmod-nvidia* is -2.fc44 while xorg-x11-drv-nvidia* is -1.fc44).
ARG NVIDIA_DRIVER_VERSION=595.58.03
# 1. RPM Fusion + open NVIDIA kmod compiled at build time for KERNEL_VERSION.
#    RPM Fusion stopped shipping precompiled kmod-nvidia-open-<driver>-<kernel>
#    packages on Fedora 44; the kmod-nvidia-open metapackage now contains no
#    files and pulls in akmod-nvidia-open. We build the kmod here with akmods,
#    then strip the toolchain.
#
#    Both akmod-nvidia (proprietary) and akmod-nvidia-open are installed at
#    the same pinned version because xorg-x11-drv-nvidia depends on the
#    virtual cap `nvidia-kmod`, which only the proprietary kmod provides at
#    dnf-resolve time. We then build ONLY the open kmod via
#    `akmods --kmod nvidia-open`, so no proprietary nvidia.ko ends up in
#    /lib/modules and modprobe loads the open one at boot.
#
#    Also block nouveau via kargs + modprobe so the open driver can bind the
#    GPU at boot instead of losing the race.
RUN dnf install -y \
		https://mirrors.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-44.noarch.rpm \
	&& dnf install -y python3-dnf-plugin-versionlock \
	&& dnf install -y --exclude='xorg-x11-drv-nvidia-580xx*' \
		akmods \
		akmod-nvidia-${NVIDIA_DRIVER_VERSION} \
		akmod-nvidia-open-${NVIDIA_DRIVER_VERSION} \
		kernel-devel-${KERNEL_VERSION} \
		xorg-x11-drv-nvidia-${NVIDIA_DRIVER_VERSION} \
		xorg-x11-drv-nvidia-cuda-${NVIDIA_DRIVER_VERSION} \
		xorg-x11-drv-nvidia-cuda-libs-${NVIDIA_DRIVER_VERSION} \
		xorg-x11-drv-nvidia-libs-${NVIDIA_DRIVER_VERSION} \
		xorg-x11-drv-nvidia-kmodsrc-${NVIDIA_DRIVER_VERSION} \
		xorg-x11-drv-nvidia-power-${NVIDIA_DRIVER_VERSION} \
		nvidia-modprobe-${NVIDIA_DRIVER_VERSION} \
		nvidia-persistenced-${NVIDIA_DRIVER_VERSION} \
		nvidia-settings-${NVIDIA_DRIVER_VERSION} \
	&& akmods --force --kernels ${KERNEL_VERSION} --kmod nvidia-open \
	&& depmod -a ${KERNEL_VERSION} \
	&& dnf versionlock add 'kernel-*' 'akmod-nvidia*' 'kmod-nvidia*' 'xorg-x11-drv-nvidia*' 'nvidia-modprobe' 'nvidia-persistenced' 'nvidia-settings' \
	&& systemctl enable nvidia-persistenced \
	&& dnf clean all \
	&& rm -rf /var/cache/akmods

# 1b. Block nouveau so the GPU isn't claimed by the wrong driver at boot.
#     Both pieces are needed: kargs.d covers early-userspace + kernel cmdline
#     across upgrades; modprobe.d catches anything that tries to load it later.
COPY 10-nvidia.toml /usr/lib/bootc/kargs.d/10-nvidia.toml
COPY block-nouveau.conf /etc/modprobe.d/block-nouveau.conf

# 2. NVIDIA Container Toolkit (CDI) for Podman GPU passthrough.
#    metrics-base ships /etc/ssl/certs/ca-bundle.crt but not the canonical
#    /etc/pki/tls/certs/ca-bundle.crt that libcurl-built-against-NSS expects,
#    which makes dnf fail to fetch the NVIDIA repo metadata. Create the
#    missing symlink before adding the repo.
RUN ln -sf /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem /etc/pki/tls/certs/ca-bundle.crt \
	&& curl -sL https://nvidia.github.io/libnvidia-container/stable/rpm/nvidia-container-toolkit.repo \
		-o /etc/yum.repos.d/nvidia-container-toolkit.repo \
	&& dnf install -y nvidia-container-toolkit \
	&& dnf clean all

# 3. vLLM and Open WebUI containers as logically bound images. bootc pulls
#    them into /usr/lib/bootc/storage alongside the OS image.
COPY llm-vllm.image /usr/share/containers/systemd/llm-vllm.image
COPY llm-webui.image /usr/share/containers/systemd/llm-webui.image
RUN install -d -m 0755 /usr/lib/bootc/bound-images.d \
	&& ln -s ../../../share/containers/systemd/llm-vllm.image \
		/usr/lib/bootc/bound-images.d/llm-vllm.image \
	&& ln -s ../../../share/containers/systemd/llm-webui.image \
		/usr/lib/bootc/bound-images.d/llm-webui.image

# 4. Firewall: 80/443 only; vLLM stays on loopback
RUN firewall-offline-cmd --zone=public --add-port=80/tcp \
	&& firewall-offline-cmd --zone=public --add-port=443/tcp

# 5. Caddy
RUN dnf install -y caddy && systemctl enable caddy && dnf clean all
COPY Caddyfile.khtmpl /etc/caddy/Caddyfile.khtmpl

# 6. Grafana sub-path support
COPY grafana-subpath.env.khtmpl /etc/kheeper/grafana-subpath.env.khtmpl
RUN install -d -m 0755 /usr/lib/systemd/system/grafana.service.d
COPY grafana-subpath.conf /usr/lib/systemd/system/grafana.service.d/10-llm.conf

# 7. vLLM quadlet + Open WebUI quadlet + env templates + CDI init + model-link.
#    The leaf image declares model weights as a logically bound image (a
#    FROM-scratch *-weights image) and ships a static env file with
#    VLLM_SERVED_MODEL_NAME to /etc/kheeper/llm-vllm-model.env.
#    llm-model-link resolves the bound image to a filesystem path at boot.
COPY llm-vllm.container /usr/share/containers/systemd/llm-vllm.container
COPY llm-vllm.env.khtmpl /etc/kheeper/llm-vllm.env.khtmpl
COPY llm-webui.container /usr/share/containers/systemd/llm-webui.container
COPY llm-webui.env.khtmpl /etc/kheeper/llm-webui.env.khtmpl
COPY llm-cdi-init.service /usr/lib/systemd/system/llm-cdi-init.service
COPY --chmod=0755 llm-cdi-init.sh /usr/local/sbin/llm-cdi-init
COPY llm-model-link.service /usr/lib/systemd/system/llm-model-link.service
COPY --chmod=0755 llm-model-link.sh /usr/local/sbin/llm-model-link
RUN systemctl enable llm-cdi-init llm-model-link

# 8. tmpfiles.d
COPY kheeper.conf /usr/lib/tmpfiles.d/kheeper-llm.conf

# 9. Metrics + dashboard
COPY llm-scrape.json /etc/victoria-metrics/scrape.d/llm.json
COPY grafana-dashboards/llm.json /etc/grafana/dashboards/llm.json

# 10. Schema for the .llm config block (shared across all leaf LLM images)
COPY schema.json /etc/kheeper/schema.d/llm.json
