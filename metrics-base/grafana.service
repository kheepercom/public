[Unit]
Description=Grafana
After=network-online.target victoria-metrics.service
Wants=network-online.target

[Service]
Type=notify
User=grafana
Group=grafana
EnvironmentFile=/etc/sysconfig/grafana-server
WorkingDirectory=/usr/share/grafana
RuntimeDirectory=grafana
RuntimeDirectoryMode=0750
StateDirectory=grafana
StateDirectoryMode=0750
LogsDirectory=grafana
LogsDirectoryMode=0750
# Heal ownership of pre-existing data if UIDs ever drift (no-op when matching).
ExecStartPre=+/usr/bin/chown -R grafana:grafana /var/lib/grafana /var/log/grafana
ExecStart=/usr/share/grafana/bin/grafana server \
    --config=${CONF_FILE} \
    --pidfile=${PID_FILE_DIR}/grafana-server.pid \
    --packaging=rpm \
    cfg:default.paths.logs=${LOG_DIR} \
    cfg:default.paths.data=${DATA_DIR} \
    cfg:default.paths.plugins=${PLUGINS_DIR} \
    cfg:default.paths.provisioning=${PROVISIONING_CFG_DIR}
Restart=on-failure
LimitNOFILE=10000
TimeoutStopSec=20

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service @resources mincore
SystemCallFilter=~@privileged
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
