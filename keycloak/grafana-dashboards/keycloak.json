{
  "uid": "keycloak-overview",
  "title": "Keycloak Overview",
  "tags": [
    "keycloak"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "VictoriaMetrics"
        },
        "query": "label_values(process_uptime_seconds{job=\"keycloak\"}, instance)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "current": {
          "selected": false,
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Logins (1h)",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        }
      },
      "targets": [
        {
          "expr": "sum(increase(keycloak_user_events_total{job=\"keycloak\",instance=~\"$instance\",event=\"login\",error=\"\"}[1h]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Failed Logins (1h)",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(increase(keycloak_user_events_total{job=\"keycloak\",instance=~\"$instance\",event=\"login\",error!=\"\"}[1h]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Request Rate (req/s)",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2
        }
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"keycloak\",instance=~\"$instance\",uri!~\"/health.*|/metrics\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "p99 Latency",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"keycloak\",instance=~\"$instance\",uri!~\"/health.*|/metrics\"}[5m]))) * 1000",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Logins by Realm",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum by (realm) (increase(keycloak_user_events_total{job=\"keycloak\",instance=~\"$instance\",event=\"login\",error=\"\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{realm}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Failed Logins by Error",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum by (realm, error) (increase(keycloak_user_events_total{job=\"keycloak\",instance=~\"$instance\",event=\"login\",error!=\"\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{realm}} {{error}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "User Events by Type",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum by (event) (increase(keycloak_user_events_total{job=\"keycloak\",instance=~\"$instance\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{event}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Request Rate by Status",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"keycloak\",instance=~\"$instance\",uri!~\"/health.*|/metrics\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Latency Quantiles",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"keycloak\",instance=~\"$instance\",uri!~\"/health.*|/metrics\"}[5m]))) * 1000",
          "refId": "A",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"keycloak\",instance=~\"$instance\",uri!~\"/health.*|/metrics\"}[5m]))) * 1000",
          "refId": "B",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"keycloak\",instance=~\"$instance\",uri!~\"/health.*|/metrics\"}[5m]))) * 1000",
          "refId": "C",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Database Pool",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum(agroal_active_count{job=\"keycloak\",instance=~\"$instance\"})",
          "refId": "A",
          "legendFormat": "active"
        },
        {
          "expr": "sum(agroal_available_count{job=\"keycloak\",instance=~\"$instance\"})",
          "refId": "B",
          "legendFormat": "available"
        },
        {
          "expr": "sum(agroal_awaiting_count{job=\"keycloak\",instance=~\"$instance\"})",
          "refId": "C",
          "legendFormat": "awaiting"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "JVM Heap",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{job=\"keycloak\",instance=~\"$instance\",area=\"heap\"})",
          "refId": "A",
          "legendFormat": "used"
        },
        {
          "expr": "sum(jvm_memory_committed_bytes{job=\"keycloak\",instance=~\"$instance\",area=\"heap\"})",
          "refId": "B",
          "legendFormat": "committed"
        },
        {
          "expr": "sum(jvm_memory_max_bytes{job=\"keycloak\",instance=~\"$instance\",area=\"heap\"})",
          "refId": "C",
          "legendFormat": "max"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "CPU and GC",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "targets": [
        {
          "expr": "process_cpu_usage{job=\"keycloak\",instance=~\"$instance\"}",
          "refId": "A",
          "legendFormat": "cpu"
        },
        {
          "expr": "sum(rate(jvm_gc_pause_seconds_sum{job=\"keycloak\",instance=~\"$instance\"}[5m]))",
          "refId": "B",
          "legendFormat": "gc pause"
        }
      ]
    }
  ]
}
