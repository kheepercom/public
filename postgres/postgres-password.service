[Unit]
Description=Apply postgres superuser password and public hba rule
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=postgres
Group=postgres
EnvironmentFile=/etc/kheeper/postgres-password.env
ExecStart=/usr/local/sbin/postgres-password-apply
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
