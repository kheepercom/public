#!/bin/bash
# Reads bootc-image and bootc-auth from GCE instance metadata or the bootc key
# of AWS #cloud-config user-data, then switches this host to bootc-image and
# reboots into it.
set -euo pipefail

gce() {
	curl -fsS --retry 10 --retry-connrefused -H 'Metadata-Flavor: Google' \
		"http://169.254.169.254/computeMetadata/v1/instance/attributes/$1" 2>/dev/null || true
}

# The rest of the user-data is for cloud-init in the user's image, which
# ignores the bootc key.
aws() {
	local token
	token=$(curl -fsS --retry 10 --retry-connrefused -X PUT \
		-H 'X-aws-ec2-metadata-token-ttl-seconds: 60' http://169.254.169.254/latest/api/token)
	curl -fsS -H "X-aws-ec2-metadata-token: ${token}" http://169.254.169.254/latest/user-data 2>/dev/null \
		| python3 -c '
import sys, yaml
try:
    print(yaml.safe_load(sys.stdin)["bootc"][sys.argv[1]] or "")
except Exception:
    pass
' "$1" || true
}

if grep -q Google /sys/class/dmi/id/product_name; then
	md=gce
	image=$(gce bootc-image)
	auth=$(gce bootc-auth)
else
	md=aws
	image=$(aws image)
	auth=$(aws auth)
fi

if [ -z "$image" ]; then
	echo "bootc-quickstart: no image in $md metadata; set it and reboot"
	exit 0
fi

if [ -n "$auth" ]; then
	install -d -m 0700 /etc/ostree
	printf '{"auths":{"%s":{"auth":"%s"}}}\n' "${image%%/*}" "$(printf %s "$auth" | base64 -w0)" >/etc/ostree/auth.json
	chmod 0600 /etc/ostree/auth.json
fi

# The disk image's root partition is small. Grow it to the disk so the new
# image fits.
part=$(findmnt -no SOURCE /sysroot | sed 's/\[.*//')
growpart "/dev/$(lsblk -no pkname "$part" | head -1)" "$(cat "/sys/class/block/$(basename "$part")/partition")" || true
xfs_growfs /var

echo "bootc-quickstart: switching to $image"
# Started by systemd, bootc runs as install_t, which may write SELinux labels
# this image's policy has never heard of. Started from here it could not.
systemd-run --wait --pipe --quiet --collect bootc switch --apply "$image"
