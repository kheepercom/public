# Built by sauce's build-bootc-quickstart workflow. It lives under gce/ so
# the public builder, which builds top-level directories, skips it.
# latest quay.io/fedora/fedora-bootc:45-x86_64
FROM quay.io/fedora/fedora-bootc@sha256:1b95805de4fffac8f03a4deb0416411cdcff355d0e16012304227cbbe758934c AS builder
# Minimal leaves little in /etc and /var to carry over into the user's image.
RUN /usr/libexec/bootc-base-imagectl build-rootfs --manifest=minimal \
	--install systemd-networkd --install cloud-utils-growpart /target-rootfs

FROM scratch
COPY --from=builder /target-rootfs/ /
COPY --chmod=0755 bootc-quickstart /usr/local/bin/bootc-quickstart
COPY bootc-quickstart.service /usr/lib/systemd/system/bootc-quickstart.service
COPY 80-dhcp.network /usr/lib/systemd/network/80-dhcp.network
COPY ostree-finalize-staged-path.conf /usr/lib/systemd/system/ostree-finalize-staged.service.d/path.conf
RUN systemctl enable systemd-networkd systemd-networkd-wait-online systemd-resolved bootc-quickstart
LABEL containers.bootc=1
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
