[Unit]
Description=Gemma 4 31B-it vLLM inference server
After=gemma4-cdi-init.service network-online.target
Requires=gemma4-cdi-init.service
Wants=network-online.target

[Container]
Image=docker.io/vllm/vllm-openai:v0.21.0
ContainerName=gemma4-vllm
EnvironmentFile=/etc/kheeper/gemma4-vllm.env
PublishPort=127.0.0.1:8000:8000
# No Z: the model lives in /usr (ostree composefs, read-only). Its label was
# set at image build time; the runtime relabel that ":Z" triggers fails with
# lsetxattr EROFS on bootc hosts.
Volume=/usr/share/gemma4/model:/model:ro
Volume=/var/lib/vllm:/root/.cache:Z
AddDevice=nvidia.com/gpu=all
SecurityLabelDisable=true
Exec=--model /model --served-model-name google/gemma-4-31B-it --api-key ${VLLM_API_KEY} --max-model-len ${VLLM_MAX_MODEL_LEN} --gpu-memory-utilization ${VLLM_GPU_MEM_UTIL} --host 0.0.0.0 --port 8000

[Service]
# Loaded into the systemd unit so ${VLLM_*} in Exec= expands. EnvironmentFile=
# in [Container] only feeds the container's env, not the systemd unit.
EnvironmentFile=/etc/kheeper/gemma4-vllm.env
Restart=on-failure
RestartSec=10s
TimeoutStartSec=600s

[Install]
WantedBy=multi-user.target
