FROM us.kheeper.com/public/llm-base:v0.3.1

# Model weights as a logically bound image. bootc pulls gemma4-weights into
# /sysroot/ostree/bootc/storage alongside this OS image, separately versioned,
# so OS rebuilds never re-pull the multi-tens-of-GB weight layer.
# llm-model-link.service (from llm-base) resolves this to /var/lib/llm-model
# at boot; the vLLM container bind-mounts that path at /model.
COPY llm-model.image /usr/share/containers/systemd/llm-model.image
RUN install -d -m 0755 /usr/lib/bootc/bound-images.d \
	&& ln -s ../../../share/containers/systemd/llm-model.image \
		/usr/lib/bootc/bound-images.d/llm-model.image

# Static env: the model identity vLLM advertises on /v1/models.
COPY llm-vllm-model.env /etc/kheeper/llm-vllm-model.env

RUN bootc container lint
