[Unit]
Description=OpenFGA Authorization Service
After=postgresql.service openfga-db-init.service
Requires=postgresql.service openfga-db-init.service

[Service]
User=openfga
Group=openfga

Environment=OPENFGA_DATASTORE_ENGINE=postgres
Environment=OPENFGA_DATASTORE_URI=postgres://openfga@localhost/openfga?host=/var/run/postgresql&sslmode=disable
Environment=OPENFGA_AUTHN_METHOD=preshared
Environment=OPENFGA_PLAYGROUND_ENABLED=false
Environment=OPENFGA_HTTP_ADDR=127.0.0.1:8080
Environment=OPENFGA_GRPC_ADDR=127.0.0.1:8081
Environment=OPENFGA_METRICS_ADDR=127.0.0.1:2112
# openfga >=1.14 reads $HOME/.pgpass via a pgxpool BeforeConnect hook even when
# the URI is passwordless. ProtectHome=yes makes the default /var/home/openfga
# return EACCES (fatal) instead of ENOENT (ignored), so point HOME at the
# per-service PrivateTmp /tmp where the lookup cleanly misses.
Environment=HOME=/tmp

EnvironmentFile=/etc/kheeper/openfga.env

ExecStartPre=/usr/local/bin/openfga migrate

ExecStart=/usr/local/bin/openfga run

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service @resources mincore
SystemCallFilter=~@privileged
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
ReadWritePaths=/var/run/postgresql

[Install]
WantedBy=multi-user.target
