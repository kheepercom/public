[Unit]
Description=Create OpenFGA postgres role and database
After=postgresql.service
Requires=postgresql.service
Before=openfga.service

[Service]
Type=oneshot
User=postgres
Group=postgres
ExecStart=/usr/bin/psql -v ON_ERROR_STOP=1 -d postgres -f /etc/kheeper/openfga-db-init.sql
RemainAfterExit=yes

[Install]
WantedBy=openfga.service
