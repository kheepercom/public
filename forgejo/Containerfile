FROM us.kheeper.com/public/postgres-base:v0.4.0

ARG VERSION=16.0.3
ARG RUNNER_VERSION=13.0.0

# nodejs runs the JS-based actions (e.g. actions/checkout) under the host executor.
RUN dnf install -y \
	caddy \
	git \
	nodejs \
	&& dnf clean all \
	&& rm -rf /var/cache/* /var/lib/dnf /var/lib/pgsql /var/lib/caddy /var/log/* /tmp/* \
	&& rm -rf /run/dnf /run/lock /run/log

# 80/443 for Caddy/ACME, 22 for git-over-SSH (Forgejo), 2222 for admin sshd.
# 22 is already opened by the base image.
RUN firewall-offline-cmd --zone=public --add-port=80/tcp \
	&& firewall-offline-cmd --zone=public --add-port=443/tcp \
	&& firewall-offline-cmd --zone=public --add-port=2222/tcp

# Move admin sshd to 2222 so Forgejo's git SSH server can bind the default port 22
COPY sshd-port.conf /etc/ssh/sshd_config.d/20-forgejo-sshd-port.conf

RUN systemctl enable caddy
COPY Caddyfile.khtmpl /etc/caddy/Caddyfile.khtmpl

RUN curl -fLO https://codeberg.org/forgejo/forgejo/releases/download/v${VERSION}/forgejo-${VERSION}-linux-amd64 \
	&& install -m 0755 forgejo-${VERSION}-linux-amd64 /usr/local/bin/forgejo \
	&& rm forgejo-${VERSION}-linux-amd64

RUN curl -fLO https://code.forgejo.org/forgejo/runner/releases/download/v${RUNNER_VERSION}/forgejo-runner-${RUNNER_VERSION}-linux-amd64 \
	&& install -m 0755 forgejo-runner-${RUNNER_VERSION}-linux-amd64 /usr/local/bin/act_runner \
	&& rm forgejo-runner-${RUNNER_VERSION}-linux-amd64

# The git user must come from sysusers.d, not a bare build-time useradd: bootc
# 3-way-merges /etc, so a build-only /etc/passwd write is dropped on a fresh
# host and the service dies with 217/USER. Ship the declarative conf (regenerated
# every boot) AND create the user at build so the /etc/forgejo chowns below
# resolve; pin the UID/GID so /var/lib/forgejo data keeps its owner.
COPY git.sysusers /usr/lib/sysusers.d/forgejo-git.conf
RUN groupadd --system --gid 973 git \
	&& useradd --system --uid 973 --gid 973 --no-create-home --home-dir /var/lib/forgejo --shell /sbin/nologin --groups postgres git

RUN install -d -o root -g git -m 0770 /etc/forgejo
COPY --chown=root:git --chmod=0660 app.ini /etc/forgejo/app.ini

COPY forgejo.service /usr/lib/systemd/system/forgejo.service
COPY forgejo-init.service /usr/lib/systemd/system/forgejo-init.service
COPY --chmod=0755 forgejo-init.sh /usr/local/sbin/forgejo-init
COPY forgejo.env.khtmpl /etc/kheeper/forgejo.env.khtmpl
COPY kheeper.conf /usr/lib/tmpfiles.d/kheeper-forgejo.conf

# Forgejo's postgres role + database are created by the shared kheeper-db-init
# from postgres-base; this starter default points it at the forgejo db/user.
COPY starter.d/database.json /etc/kheeper/starter.d/database.json

# Forgejo Actions runner (host executor), co-located with Forgejo. Runs job
# steps directly on the host as the unprivileged act-runner user (declared via
# sysusers.d for the same bootc /etc-merge reason as git above). act-runner-init
# registers it against the local instance on first boot.
COPY act-runner.sysusers /usr/lib/sysusers.d/act-runner.conf
COPY --chmod=0644 act-runner-config.yaml /etc/act-runner/config.yaml
COPY act-runner.service /usr/lib/systemd/system/act-runner.service
COPY act-runner-init.service /usr/lib/systemd/system/act-runner-init.service
COPY --chmod=0755 act-runner-init.sh /usr/local/sbin/act-runner-init

# Rootless podman for the host executor needs act-runner to have subuid/subgid
# ranges. Provisioned at boot (see script) because bootc drops build-time /etc
# writes on a fresh host.
COPY act-runner-subid.service /usr/lib/systemd/system/act-runner-subid.service
COPY --chmod=0755 act-runner-subid.sh /usr/local/sbin/act-runner-subid

# Always-on podman API socket for the runner, so workflows use DOCKER_HOST
# (preset in act-runner-config.yaml via runner.envs) without starting podman.
# act-runner-linger gives the runner a systemd --user session so rootless
# container DNS (aardvark-dns) has a user bus to attach to; the podman socket
# runs inside that session.
COPY act-runner-linger.service /usr/lib/systemd/system/act-runner-linger.service
COPY act-runner-podman.service /usr/lib/systemd/system/act-runner-podman.service

RUN systemctl enable forgejo-init forgejo act-runner-init act-runner-subid act-runner-linger act-runner-podman act-runner

COPY forgejo-scrape.json /etc/victoria-metrics/scrape.d/forgejo.json
COPY grafana-dashboards/forgejo.json /etc/grafana/dashboards/forgejo.json

COPY schema.json /etc/kheeper/schema.d/forgejo.json

RUN bootc container lint
