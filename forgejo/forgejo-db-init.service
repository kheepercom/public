[Unit]
Description=Create Forgejo postgres role and database
After=postgresql.service
Requires=postgresql.service
Before=forgejo-init.service

[Service]
Type=oneshot
User=postgres
Group=postgres
ExecStart=/usr/bin/psql -v ON_ERROR_STOP=1 -d postgres -f /etc/kheeper/forgejo-db-init.sql
RemainAfterExit=yes

[Install]
WantedBy=forgejo-init.service
