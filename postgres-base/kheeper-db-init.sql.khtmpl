-- Rendered from the `database` config namespace. Idempotent.
{{ with .database }}{{ if and .name .users }}
{{ $db := .name }}{{ $owner := (index .users 0).name }}
-- Roles (LOGIN). Password set when provided -> enables scram/TCP auth.
{{ range .users }}
SELECT format('CREATE ROLE %I LOGIN', '{{ .name }}')
WHERE NOT EXISTS (SELECT FROM pg_roles WHERE rolname = '{{ .name }}')\gexec
{{ if .password }}
SELECT format('ALTER ROLE %I PASSWORD %L', '{{ .name }}', '{{ .password | replace "'" "''" }}')\gexec
{{ end }}
{{ end }}
-- Database owned by the first user.
SELECT format('CREATE DATABASE %I OWNER %I', '{{ $db }}', '{{ $owner }}')
WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = '{{ $db }}')\gexec
{{ range (slice .users 1) }}
-- Additional user: full access to the database.
SELECT format('GRANT ALL PRIVILEGES ON DATABASE %I TO %I', '{{ $db }}', '{{ .name }}')\gexec
{{ end }}
{{ if gt (len .users) 1 }}
\connect "{{ $db }}"
{{ range (slice .users 1) }}
SELECT format('GRANT ALL ON SCHEMA public TO %I', '{{ .name }}')\gexec
SELECT format('GRANT ALL ON ALL TABLES IN SCHEMA public TO %I', '{{ .name }}')\gexec
SELECT format('GRANT ALL ON ALL SEQUENCES IN SCHEMA public TO %I', '{{ .name }}')\gexec
SELECT format('ALTER DEFAULT PRIVILEGES FOR ROLE %I IN SCHEMA public GRANT ALL ON TABLES TO %I', '{{ $owner }}', '{{ .name }}')\gexec
SELECT format('ALTER DEFAULT PRIVILEGES FOR ROLE %I IN SCHEMA public GRANT ALL ON SEQUENCES TO %I', '{{ $owner }}', '{{ .name }}')\gexec
{{ end }}
{{ end }}
{{ end }}{{ end }}
